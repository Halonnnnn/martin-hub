# 对外监听地址：
#   0.0.0.0   直接暴露端口（无域名/临时验证；生产请在前置 TLS 反代）
#   127.0.0.1 只监听本机，由宿主机 Nginx/Caddy 反代
MARTIN_BIND=0.0.0.0
MARTIN_PUBLISH_PORT=8000

POSTGRES_USER=martin
POSTGRES_PASSWORD=请用-openssl-rand-hex-16-生成
POSTGRES_DB=martin

# 会话签名密钥；生成：openssl rand -hex 32
MARTIN_SECRET_KEY=请用-openssl-rand-hex-32-生成

# 可选：Python 依赖源（默认清华镜像；海外服务器改成 https://pypi.org/simple）
# PIP_INDEX_URL=https://pypi.org/simple

# 可选：前端依赖源（默认官方 npm；国内服务器改成 https://registry.npmmirror.com）
# NPM_REGISTRY=https://registry.npmmirror.com
