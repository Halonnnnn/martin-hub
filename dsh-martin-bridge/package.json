{
  "name": "dsh-martin-bridge",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "description": "Inject Martin wake events into the DSH session you are currently using.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
